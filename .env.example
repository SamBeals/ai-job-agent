# Discord bot credentials (required to run the bot)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Application
APP_ENV=development
DATABASE_URL=sqlite:///./data/ai_job_agent.db
ENABLE_TEST_COMMANDS=true
CANDIDATE_PROFILE_PATH=./data/candidate_profile.json

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# Scout / LLM
# mock = deterministic evidence-grounded evaluator (default, no paid API)
# openai = structured SemanticJobEvaluation via OpenAI (requires OPENAI_API_KEY)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
OPENAI_API_KEY=
# none = surface evaluator failures clearly (never silently fall back to mock)
LLM_FAILURE_FALLBACK=none
SCOUT_PROMPT_VERSION=qualification-v1
SCOUT_EVALUATOR_VERSION=2a.6
SCOUT_MIN_QUALIFICATION_SCORE=55
SCOUT_MIN_DESIRABILITY_SCORE=50
SCOUT_STRONG_QUALIFICATION_SCORE=80
SCOUT_STRONG_DESIRABILITY_SCORE=75
SCOUT_MAYBE_QUALIFICATION_SCORE=40
SCOUT_MAYBE_DESIRABILITY_SCORE=40

# Manual job ingestion (Phase 2A.5)
INGESTION_HTTP_TIMEOUT_SECONDS=15
INGESTION_MAX_RESPONSE_BYTES=2000000
INGESTION_MAX_REDIRECTS=5
INGESTION_USER_AGENT=AI-Job-Agent-Scout/2A.5 (+local; manual job evaluation; not a crawler)
INGESTION_EXTRACTOR_VERSION=2a.5.1

# Multi-agent pipeline worker (Phase 2A.7 / Phase 3 foundation)
AGENT_MAX_ATTEMPTS=3
AGENT_WORKER_POLL_SECONDS=2
RESUME_AGENT_VERSION=3.0.0
