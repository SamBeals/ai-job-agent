# Discord bot credentials (required to run the bot)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Agent activity webhook (SECRET — never commit the real URL)
# Used for per-agent username/avatar presentation. Control-plane bot stays separate.
# Bot/worker logging redacts this URL; httpx request lines are not logged at INFO.
DISCORD_AGENT_WEBHOOK_URL=
DISCORD_WEBHOOK_TIMEOUT_SECONDS=5

# Optional per-agent avatar overrides (public image URLs)
SCOUT_AVATAR_URL=
RESUME_AVATAR_URL=
RESUME_REVIEW_AVATAR_URL=
APPLICANT_AVATAR_URL=
DISCOVERY_AVATAR_URL=
TRACKER_AVATAR_URL=

# Application
APP_ENV=development
DATABASE_URL=sqlite:///./data/ai_job_agent.db
ENABLE_TEST_COMMANDS=true
CANDIDATE_PROFILE_PATH=./data/candidate_profile.json

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# Scout / LLM
# mock = deterministic evidence-grounded evaluator (default, no paid API)
# openai = structured SemanticJobEvaluation via OpenAI (requires OPENAI_API_KEY)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
OPENAI_API_KEY=
# none = surface evaluator failures clearly (never silently fall back to mock)
LLM_FAILURE_FALLBACK=none
SCOUT_PROMPT_VERSION=qualification-v1
SCOUT_EVALUATOR_VERSION=2a.6
SCOUT_MIN_QUALIFICATION_SCORE=55
SCOUT_MIN_DESIRABILITY_SCORE=50
SCOUT_STRONG_QUALIFICATION_SCORE=80
SCOUT_STRONG_DESIRABILITY_SCORE=75
SCOUT_MAYBE_QUALIFICATION_SCORE=40
SCOUT_MAYBE_DESIRABILITY_SCORE=40

# Manual job ingestion (Phase 2A.5)
INGESTION_HTTP_TIMEOUT_SECONDS=15
INGESTION_MAX_RESPONSE_BYTES=2000000
INGESTION_MAX_REDIRECTS=5
INGESTION_USER_AGENT=AI-Job-Agent-Scout/2A.5 (+local; manual job evaluation; not a crawler)
INGESTION_EXTRACTOR_VERSION=2a.5.1

# Multi-agent pipeline worker (Phase 2A.7 / Phase 3 foundation)
AGENT_MAX_ATTEMPTS=3
AGENT_WORKER_POLL_SECONDS=2
RESUME_AGENT_VERSION=3.0.0

# Discovery Agent (Phase 3.2 / 3.3)
# auto = all enabled providers; fake = tests only; or comma list of provider names
DISCOVERY_PROVIDER=auto
DISCOVERY_MAX_RAW_RESULTS=100
DISCOVERY_MAX_SURFACED_RESULTS=10
# Minimum discovery_score to surface (max is a ceiling, not a fill target)
DISCOVERY_MIN_SURFACE_SCORE=45
DISCOVERY_RESULT_MAX_AGE_DAYS=30
DISCOVERY_HTTP_TIMEOUT_SECONDS=15
DISCOVERY_BOARDS_PATH=config/discovery_boards.json
DISCOVERY_GREENHOUSE_ENABLED=true
DISCOVERY_LEVER_ENABLED=true
DISCOVERY_ASHBY_ENABLED=true
DISCOVERY_REMOTIVE_ENABLED=true
DISCOVERY_ENABLE_REMOTIVE=true
DISCOVERY_MUSE_ENABLED=true
DISCOVERY_ADZUNA_ENABLED=false
# Optional env tenants merged with discovery_boards.json
DISCOVERY_GREENHOUSE_BOARDS=stripe,datadog,cloudflare,gitlab,hashicorp,twilio,airbnb,discord
DISCOVERY_GREENHOUSE_COMPANY_NAMES=stripe:Stripe;datadog:Datadog;cloudflare:Cloudflare;gitlab:GitLab;hashicorp:HashiCorp;twilio:Twilio;airbnb:Airbnb;discord:Discord
DISCOVERY_LEVER_SITES=
DISCOVERY_LEVER_COMPANY_NAMES=
DISCOVERY_ASHBY_BOARDS=
DISCOVERY_ASHBY_COMPANY_NAMES=
# Adzuna optional Type B — https://developer.adzuna.com/ (never commit real keys)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
DISCOVERY_ADZUNA_APP_ID=
DISCOVERY_ADZUNA_APP_KEY=
DISCOVERY_API_KEY=
